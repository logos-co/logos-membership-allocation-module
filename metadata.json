{
  "name": "membership_allocation_module",
  "version": "0.1.0",
  "description": "RLN membership allocator: serves membership registration requests over libp2p, authenticates them with its built-in auth vectors or a verifier module and registers them through rln_lez_module",
  "author": "Logos",
  "type": "core",
  "interface": "cdylib",
  "category": "blockchain",
  "main": "membership_allocation_module_plugin",
  "dependencies": ["libp2p_module", "rln_lez_module"],
  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": {
      "crate": "rust-lib",
      "trait": "MembershipAllocationModule"
    }
  },
  "dependency_overrides": {
    "rln_lez_module": {
      "file": "rust-lib/deps/rln_lez_module.lidl"
    }
  },
  "nix": {
    "external_libraries": [],
    "packages": {
      "build": [],
      "runtime": []
    },
    "cmake": {
      "find_packages": [],
      "extra_include_dirs": []
    }
  }
}
